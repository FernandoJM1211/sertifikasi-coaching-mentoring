# URL publik aplikasi (dipakai untuk tautan aktivasi akun & validasi origin)
APP_BASE_URL=http://localhost:3000

# Google Service Account - path ke file kredensial JSON (JANGAN di-commit) — untuk lokal
# Untuk hosting tanpa file (mis. Vercel) pakai GOOGLE_SERVICE_ACCOUNT_JSON (isi JSON, mentah atau base64)
# GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Google Sheets - spreadsheet data operasional CMSP
GOOGLE_SPREADSHEET_ID=

# Google Sheets - spreadsheet autentikasi CMSP (users, sessions, activation_tokens)
AUTH_SPREADSHEET_ID=

# Google Drive - folder penyimpanan dokumen peserta
GOOGLE_DRIVE_FOLDER_ID=

# Google OAuth - akun Drive aplikasi (dihubungkan Super Admin via /api/auth/google)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Lokal: file penyimpan refresh token. Hosting (mis. Vercel): isi GOOGLE_OAUTH_REFRESH_TOKEN
# dengan nilai refresh_token dari file tersebut (diutamakan bila diisi).
GOOGLE_OAUTH_TOKEN_PATH=

# Gmail - pengiriman email aktivasi akun peserta
GMAIL_USER=
GMAIL_APP_PASSWORD=
